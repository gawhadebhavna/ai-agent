# -----------------------------------------------
# App
# -----------------------------------------------
APP_NAME=Migration Automation API
APP_ENV=development

# -----------------------------------------------
# AWS
# -----------------------------------------------
AWS_REGION=ap-south-1
# Provide either explicit credentials OR a profile, not both.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

ALLOWED_BUCKETS=agentic-ai-migration-bkt
ALLOWED_PREFIXES_JSON={"agentic-ai-migration-bkt":["landing/"]}

# -----------------------------------------------
# LLM Provider  (ollama | openai | azure_openai)
# -----------------------------------------------
# Toggle this value to switch runtime model provider for unified LLM endpoints.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------------------------
# Azure OpenAI  (required when LLM_PROVIDER=azure_openai)
# -----------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# -----------------------------------------------
# Azure Blob Storage  (required for SAP agent write operations)
# -----------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=sap-api

# -----------------------------------------------
# SAP API  (mock server on port 8001)
# -----------------------------------------------
SAP_NGROK_BASE_URL=http://localhost:8001
SAP_API_USERNAME=
SAP_API_PASSWORD=

# -----------------------------------------------
# Databricks  (optional)
# -----------------------------------------------
DATABRICKS_URL=https://<your-databricks-instance>
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=123

# -----------------------------------------------
# Persistence
# -----------------------------------------------
SQLITE_PATH=./var/app.db
APPROVAL_TTL_MINUTES=30

# Set to false only as a temporary workaround when TLS interception breaks cert validation.
SSL_VERIFY=true
# Preferred for corporate proxies: trust your org CA bundle instead of disabling verification.
SSL_CA_BUNDLE=
